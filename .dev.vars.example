# Copy to .dev.vars for local development. Never commit .dev.vars.
ENVIRONMENT=local
APP_URL=http://localhost:8787
DEV_EMAIL=you@example.com
RESEND_API_KEY=re_...
# Signing secret of the Resend webhook (whsec_...); only needed to test inbound locally
RESEND_INBOUND_SECRET=whsec_...
# name=email pairs; the name is the message author shown in /admin (gizem | baran)
ADMIN_EMAILS=gizem=gizem@example.com,baran=baran@example.com
# Stripe sandbox secret key (sk_test_...) and the webhook signing secret (whsec_...)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Google OAuth client (Web application) and the 32-byte base64 key that encrypts the
# Google refresh token at rest: openssl rand -base64 32
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
ENCRYPTION_KEY=
